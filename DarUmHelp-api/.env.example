SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Deixe DATABASE_HOST em branco/comentado para rodar com SQLite localmente (python manage.py runserver).
# No docker-compose, o serviço "api" força DATABASE_HOST=db automaticamente (ver docker-compose.yml),
# então as linhas abaixo só precisam ficar consistentes com as credenciais que o container MySQL vai criar.
DATABASE_PORT=3306
DATABASE_NAME=darumhelp
DATABASE_USER=darumhelp
DATABASE_PASSWORD=darumhelp
DATABASE_ROOT_PASSWORD=darumhelp_root

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
