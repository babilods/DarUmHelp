subgraph WEB["«pacote» DarUmHelp-web (navegador)"]
  direction TB
  UI["«componente»<br/><b>Interface (index.html)</b><br/>telas, modais, toasts"]:::comp
  JS["«componente»<br/><b>script.js</b><br/>estado da sessão, renderização,<br/>aviso de mensagens novas"]:::comp
  APIC["«componente»<br/><b>Cliente REST</b><br/>apiFetch() + CSRF"]:::comp
  WSC["«componente»<br/><b>Cliente WebSocket</b><br/>chat e sinalização"]:::comp
  RTC["«componente»<br/><b>Cliente WebRTC</b><br/>RTCPeerConnection, câmera/mic"]:::comp
  UI --> JS
  JS --> APIC
  JS --> WSC
  JS --> RTC
  RTC --> WSC
end

