    SET["«componente»<br/><b>settings.py</b><br/>backends plugáveis"]:::comp
  end
  subgraph CONTAS["«pacote» contas"]
    direction TB
    CV["«componente»<br/><b>Autenticação e perfis</b><br/>registro, login, troca de e-mail,<br/>perfil do aluno, favoritos, cartões salvos"]:::comp
