  end
  subgraph PROF["«pacote» professores"]
    direction TB
    PV["«componente»<br/><b>Catálogo e perfil profissional</b><br/>busca, disciplinas, disponibilidade,<br/>uploads (currículo, vídeo, documento)"]:::comp
